DATABASE_URL=sqlite:///backend/db/tw_stock.db
DB_PATH=backend/db/tw_stock.db
TZ=Asia/Taipei
CORS_ORIGINS=http://localhost:3000
FINMIND_TOKEN=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Optional: 全站取消登入（保留程式碼可逆切回）。
# true 時 require_user / get_optional_user 都回 demo user，所有 user-bound
# 資料（watchlist 等）共用同一個帳號。前端對應 NEXT_PUBLIC_DISABLE_AUTH。
DISABLE_AUTH=false
DEMO_USER_EMAIL=demo@always-stock.dev
