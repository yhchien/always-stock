# FinMind SDK 環境變數範本
# 用法：
#   1. 複製此檔案為 .env.finmind
#   2. 填入實際的 token
#   3. 執行前 source .env.finmind

# FinMind API Token (必需)
# 取得方式：https://finmindtrade.com/
# 使用者帳戶 → API → Token 管理
FINMIND_TOKEN=your_token_here

# 可選：FinMind API base URL（一般不需修改）
FINMIND_API_URL=https://api.finmindtrade.com/api/v4

# 可選：FinMind Web API base URL（用於配額查詢）
FINMIND_WEB_API_URL=https://api.web.finmindtrade.com/v2

# 可選：ETL 日誌目錄
ETL_LOG_DIR=backend/logs

# 可選：每次 batch 要加工的行數（預設 500）
BATCH_COMMIT_SIZE=500

# 可選：HTTP 重試次數（預設 3）
HTTP_MAX_RETRIES=3

# 可選：HTTP 連接逾時秒數（預設 30）
HTTP_TIMEOUT=30

# 可選：是否啟用 async batch（推薦啟用，預設 true）
USE_ASYNC_BATCH=true

# 可選：並行 batch 任務數（預設 5，需視配額而定）
ASYNC_BATCH_CONCURRENCY=5

# 可選：資料庫連線（若不設則用 SQLite 本地開發）
# DATABASE_URL=postgresql://user:password@localhost/always_stock
