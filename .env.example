# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API (for AI strategy sub-agent)
OPENAI_API_KEY=

# Vercel AI Gateway / Jev evaluation API
AI_GATEWAY_API_KEY=
# Jev Phase 1: off (default) | shadow | assist (reserved, non-decisioning)
JEV_MODE=off
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_SECONDS=30
JEV_MAX_RETRIES=2
JEV_RETRY_BACKOFF_SECONDS=0.5
JEV_CONCURRENCY=2
JEV_MAX_API_CALLS=100

# FinMind API (optional, free tier: 300 req/hr)
FINMIND_TOKEN=

# Database path (optional, default: backend/db/tw_stock.db)
# DB_PATH=
