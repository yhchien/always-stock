DATABASE_URL=sqlite:///backend/db/tw_stock.db
DB_PATH=backend/db/tw_stock.db
TZ=Asia/Taipei
CORS_ORIGINS=http://localhost:3000
FINMIND_TOKEN=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# 註冊 / 登入功能已永久停用：require_user / get_optional_user 一律回傳 demo user，
# 所有 user-bound 資料（watchlist 等）共用同一個帳號。可逆性由 settings.is_auth_disabled()
# 控制（目前 hardcode 回 True）。下方 demo user email 可選擇性覆寫。
DEMO_USER_EMAIL=demo@always-stock.dev

# 站點訪問密碼閘門（必填）。前端 SiteGate 會 POST /api/gate/verify 比對此值；
# 未設時所有 verify request 皆回 503。請改成自己的密碼，不要用此 placeholder。
SITE_GATE_PASSWORD=please-change-me

# 密碼錯誤次數上限與鎖定秒數（預設 3 次 / 5 分鐘）。前端 mount 時讀 /api/gate/config，
# 達上限後 localStorage 寫鎖定到期時間，鎖定期內畫面只剩鎖定提示。
SITE_GATE_MAX_ATTEMPTS=3
SITE_GATE_LOCKOUT_SECONDS=300
