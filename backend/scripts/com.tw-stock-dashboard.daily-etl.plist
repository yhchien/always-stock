<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tw-stock-dashboard.daily-etl</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/brian.yh.chien/.gstack/projects/tw-stock-dashboard/backend/scripts/daily_update.sh</string>
    </array>

    <!-- Run at 20:00 every weekday (Mon-Fri) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/brian.yh.chien/.gstack/projects/tw-stock-dashboard/backend/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/brian.yh.chien/.gstack/projects/tw-stock-dashboard/backend/logs/launchd_stderr.log</string>

    <!-- Retry if missed (e.g. laptop was asleep) -->
    <key>StartInterval</key>
    <integer>0</integer>
</dict>
</plist>
